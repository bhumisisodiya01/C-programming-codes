//Develop a c function ISPRIME(num) that accepts an integer and returns 1 if ‘num’ is prime else 0.
WAP that invokes the function ISPRIME to generate prime numbers for a given range
#include <stdio.h>
int ISPRIME(int num) {
    int i;
    if (num <= 1)
        return 0;

    for (i = 2; i <= num / 2; i++) {
        if (num % i == 0)
            return 0;
    }
    return 1;
}
int main() {
    int l, h, i, r;
    printf("Enter lower limit(l) and higher limit(h): \n");
    scanf("%d %d", &l, &h);
    for(i=l;i<=h;i++)
    {
      r=ISPRIME(i);
      if (r==1)
      {
          printf("%d ", i);
         
      }
    }
    return 0;
}
